{
	"$schema": "./image-manifest.schema.json",
	"version": 1,
	"viewports": {
		"mobile": {
			"width": 390,
			"height": 844
		},
		"tablet": {
			"width": 768,
			"height": 1024
		},
		"desktop": {
			"width": 1280,
			"height": 800
		},
		"wide": {
			"width": 1920,
			"height": 1080
		}
	},
	"images": [
		{
			"id": "button-callback-editor",
			"title": "Callback popout editor",
			"description": "Expanded Popout Editor for custom checkout callback JavaScript on a button block.",
			"use": "docs",
			"match": [
				"callback editor",
				"popout editor",
				"custom js"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"desktop"
				],
				"selector": ".components-modal__frame",
				"padding": 16
			},
			"embed": {
				"from": "screenshots/button-callback-editor/source.png",
				"doc": "docs/user-guide/button.md",
				"path": "docs/assets/button-callback-editor.png",
				"alt": "Callback popout editor with custom JavaScript",
				"status": "placeholder"
			}
		},
		{
			"id": "button-checkout",
			"title": "Freemius Checkout button",
			"description": "Block editor with the Single Button scope group selected, Layout collapsed, and the Freemius sidebar panel spanning the inspector.",
			"use": "docs",
			"match": [
				"checkout",
				"freemius checkout",
				"single button",
				"checkout button"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"desktop"
				],
				"selector": ".interface-interface-skeleton__body",
				"padding": 0
			},
			"embed": {
				"from": "screenshots/button-checkout/source.png",
				"doc": "docs/user-guide/button.md",
				"path": "docs/assets/button-checkout.png",
				"alt": "Freemius Checkout button selected in the editor with Freemius sidebar settings",
				"status": "captured"
			}
		},
		{
			"id": "button-key-settings",
			"title": "Freemius options menu",
			"description": "Freemius ToolsPanel overflow menu on a button block showing optional checkout fields such as Product ID and Plan.",
			"use": "docs",
			"match": [
				"key settings",
				"three dots",
				"overflow menu",
				"freemius options"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".freemius-button-scope-settings"
			},
			"embed": {
				"from": "screenshots/button-key-settings/source.png",
				"doc": "docs/user-guide/button.md",
				"path": "docs/assets/button-key-settings.png",
				"alt": "Freemius options menu with additional checkout field toggles",
				"status": "captured"
			}
		},
		{
			"id": "button-popout-editor",
			"title": "Popout Editor button",
			"description": "Freemius sidebar showing the Popout Editor control for custom callback code.",
			"use": "docs",
			"match": [
				"popout editor",
				"events",
				"callbacks"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"desktop"
				],
				"selector": ".freemius-button-scope-settings, .interface-complementary-area",
				"padding": 16
			},
			"embed": {
				"from": "screenshots/button-popout-editor/source.png",
				"doc": "docs/user-guide/button.md",
				"path": "docs/assets/button-popout-editor.png",
				"alt": "Popout Editor control in the Freemius button settings",
				"status": "captured"
			}
		},
		{
			"id": "button-preview",
			"title": "Checkout preview",
			"description": "Freemius Preview control in the button block sidebar for testing checkout before publish.",
			"use": "docs",
			"match": [
				"preview",
				"checkout preview"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"desktop"
				],
				"selector": ".freemius-button-scope-settings, .interface-complementary-area",
				"padding": 16
			},
			"embed": {
				"from": "screenshots/button-preview/source.png",
				"doc": "docs/user-guide/button.md",
				"path": "docs/assets/button-preview.png",
				"alt": "Preview button in the Freemius button settings sidebar",
				"status": "captured"
			}
		},
		{
			"id": "button-scopes",
			"title": "Configuration scopes",
			"description": "Freemius scope hierarchy (global, page, button) in the block editor sidebar.",
			"use": "docs",
			"match": [
				"scopes",
				"configuration scopes",
				"global page button"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"desktop"
				],
				"selector": ".freemius-button-scope-settings, .interface-complementary-area",
				"padding": 16
			},
			"embed": {
				"from": "screenshots/button-scopes/source.png",
				"doc": "docs/user-guide/button.md",
				"path": "docs/assets/button-scopes.png",
				"alt": "Freemius configuration scopes in the block editor sidebar",
				"status": "captured"
			}
		},
		{
			"id": "pricing-page-checkout-button",
			"title": "Pricing checkout button",
			"description": "Editor view with a plan checkout button selected in the pricing table and the Enable Freemius Checkout toggle outlined in the sidebar.",
			"use": "docs",
			"match": [
				"pricing checkout button",
				"enable freemius checkout",
				"plan button"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".interface-interface-skeleton__editor",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/pricing-page-checkout-button/source.png",
				"doc": "docs/user-guide/creating-your-pricing-page.md",
				"path": "docs/assets/pricing-page-checkout-button.png",
				"alt": "Pricing page editor with a checkout button selected and Enable Freemius Checkout outlined",
				"status": "captured"
			}
		},
		{
			"id": "pricing-page-modifiers-row",
			"title": "Pricing modifier toggles",
			"description": "Editor canvas showing the currency, billing cycle, and license modifier button row on the pricing page, with the row outlined.",
			"use": "docs",
			"match": [
				"modifiers row",
				"pricing toggles",
				"currency billing licenses"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".interface-interface-skeleton__editor",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/pricing-page-modifiers-row/source.png",
				"doc": "docs/user-guide/creating-your-pricing-page.md",
				"path": "docs/assets/pricing-page-modifiers-row.png",
				"alt": "Pricing page editor with the modifier toggle row outlined",
				"status": "captured"
			}
		},
		{
			"id": "pricing-page-plan-column",
			"title": "Pricing plan column scope",
			"description": "Editor canvas showing the pricing plan columns with one scoped column selected and outlined.",
			"use": "docs",
			"match": [
				"plan column",
				"pricing column scope",
				"column per plan"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".interface-interface-skeleton__editor",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/pricing-page-plan-column/source.png",
				"doc": "docs/user-guide/creating-your-pricing-page.md",
				"path": "docs/assets/pricing-page-plan-column.png",
				"alt": "Pricing page editor with one plan column selected and outlined",
				"status": "captured"
			}
		},
		{
			"id": "pricing-page-playground",
			"title": "Published pricing page",
			"description": "Frontend pricing page with plan columns, modifiers, and checkout buttons.",
			"use": "docs",
			"match": [
				"pricing page",
				"playground",
				"frontend pricing"
			],
			"capture": {
				"url": "https://dev.local/playground/",
				"viewports": [
					"desktop"
				],
				"selector": ".wp-block-post-content, main",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/pricing-page-playground/source.png",
				"doc": "docs/user-guide/creating-your-pricing-page.md",
				"path": "docs/assets/pricing-page-playground.png",
				"alt": "Published Freemius pricing page with plan columns and billing toggles",
				"status": "captured"
			}
		},
		{
			"id": "pricing-page-preview",
			"title": "Pricing checkout preview",
			"description": "Editor view with the Freemius checkout preview overlay open and the Preview button outlined in the sidebar.",
			"use": "docs",
			"match": [
				"pricing preview",
				"checkout preview popup",
				"preview button"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".interface-interface-skeleton__body",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/pricing-page-preview/source.png",
				"doc": "docs/user-guide/creating-your-pricing-page.md",
				"path": "docs/assets/pricing-page-preview.png",
				"alt": "Pricing page editor with checkout preview open and the Preview button outlined",
				"status": "captured"
			}
		},
		{
			"id": "scope-enable-checkout",
			"title": "Enable Freemius on scope",
			"description": "Block editor with a scoped Group block selected, purple scope outline on the canvas, and the Freemius sidebar panel highlighted.",
			"use": "docs",
			"match": [
				"enable freemius",
				"scope",
				"group block"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".interface-interface-skeleton__body",
				"padding": 0
			},
			"embed": {
				"from": "screenshots/scope-enable-checkout/source.png",
				"doc": "docs/user-guide/scopes/README.md",
				"path": "docs/assets/scope-enable-checkout.png",
				"alt": "Editor view with scoped Group block, arrow pointing to the highlighted Freemius panel",
				"status": "captured"
			}
		},
		{
			"id": "scope-modifiers",
			"title": "Scope modifiers",
			"description": "Freemius Scope modifier block in the editor canvas with settings sidebar open.",
			"use": "docs",
			"match": [
				"modifiers",
				"scope modifier",
				"freemius scope block"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"desktop"
				],
				"selector": ".interface-interface-skeleton__editor",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/scope-modifiers/source.png",
				"doc": "docs/user-guide/scopes/modifiers.md",
				"path": "docs/assets/scope-modifiers.png",
				"alt": "Freemius Scope modifier block in the block editor",
				"status": "captured"
			}
		},
		{
			"id": "scope-pricing-mapped",
			"title": "Mapped pricing with scopes",
			"description": "Block editor canvas of the pricing table layout with purple Freemius scope outlines (same content as the playground page).",
			"use": "docs",
			"match": [
				"pricing",
				"mapping",
				"scope outline",
				"pricing page editor"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/post.php?post=FIXTURE_POST_ID&action=edit",
				"viewports": [
					"wide"
				],
				"selector": ".interface-interface-skeleton__editor",
				"padding": 24
			},
			"embed": {
				"from": "screenshots/scope-pricing-mapped/source.png",
				"doc": "docs/user-guide/scopes/mapping.md",
				"path": "docs/assets/scope-pricing-mapped.png",
				"alt": "Pricing page in the block editor with purple Freemius scope outlines",
				"status": "captured"
			}
		},
		{
			"id": "settings-editor",
			"title": "Editor Settings tab",
			"description": "Freemius admin settings page with the Editor Settings tab selected, showing site-wide default checkout fields.",
			"use": "docs",
			"match": [
				"editor settings",
				"defaults",
				"global settings"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/options-general.php?page=freemius-settings#defaults",
				"viewports": [
					"desktop"
				],
				"selector": "#freemius-settings-app",
				"padding": 0
			},
			"embed": {
				"from": "screenshots/settings-editor/source.png",
				"doc": "docs/user-guide/settings.md",
				"path": "docs/assets/settings-editor.png",
				"alt": "Editor Settings tab on the Freemius settings page",
				"status": "captured"
			}
		},
		{
			"id": "settings-products",
			"title": "Products tab",
			"description": "Freemius admin settings page with the Products tab selected, showing Product ID and Token fields.",
			"use": "docs",
			"match": [
				"products tab",
				"connect product",
				"product id token"
			],
			"capture": {
				"url": "https://dev.local/wp-admin/options-general.php?page=freemius-settings#products",
				"viewports": [
					"desktop"
				],
				"selector": "#freemius-settings-app",
				"padding": 0
			},
			"embed": {
				"from": "screenshots/settings-products/source.png",
				"doc": "docs/user-guide/creating-your-pricing-page.md",
				"path": "docs/assets/settings-products.png",
				"alt": "Products tab on the Freemius settings page",
				"status": "captured"
			}
		}
	]
}
